# Optional overrides for `make dev-api`; defaults live in the Makefile.
# USCIS_DATABASE_URL=postgresql:///uscis_etl
# POCKETBASE_USERNAME=
# POCKETBASE_PASSWORD=

# Ask gongu. Server-only. Leave URL, key or model unset to disable the feature.
# For Anthropic use https://api.anthropic.com/v1/ and an Anthropic model ID.
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
# An explicitly empty effort omits reasoning_effort.
AGENT_REASONING_EFFORT=low
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_QUESTION_OUTPUT_TOKENS=2048
AGENT_MAX_QUESTION_TOKENS=24000
AGENT_DAILY_TOKENS=100000
